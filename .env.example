# --- LLM ---
# Paid DeepSeek chat model, accessed via LiteLLM. Never hardcode model names elsewhere.
LLM_MODEL=deepseek/<current-deepseek-chat-model>
# Comma-separated fallback models, e.g. a Groq model.
LLM_FALLBACKS=groq/<groq-model>
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OLLAMA_API_BASE=http://localhost:11434

# NOTE: the following four values are placeholders. Set LLM_RPM_LIMIT/LLM_TPM_LIMIT from your
# provider's current plan limits (its dashboard, tied to your account tier/spend), and treat
# LLM_MAX_CALLS_PER_SESSION and LLM_MAX_COST_PER_SESSION_USD below as spend guardrails, not
# quota management.
LLM_MAX_CALLS_PER_SESSION=150
LLM_RPM_LIMIT=10
LLM_TPM_LIMIT=200000
LLM_CACHE_TTL_SECONDS=86400
# §5.8: dollar-denominated backstop against a stuck retry loop or runaway session draining a
# paid account — independent of LLM_MAX_CALLS_PER_SESSION (a cheap model could still cost very
# little at the call cap; an expensive one could exceed this well before it). Lower this while
# testing against a small top-up until you know roughly what a real session costs.
LLM_MAX_COST_PER_SESSION_USD=0.50

LLM_SAMPLE_ROWS=20

# --- Infra ---
DATABASE_URL=postgresql+asyncpg://datapilot:datapilot@localhost:5432/datapilot
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=datapilot-uploads

# --- Uploads & profiling ---
MAX_UPLOAD_SIZE_MB=200
# Rows cached for the virtualized preview table in the UI.
PREVIEW_ROW_LIMIT=500
# Above this row count, profiling statistics are computed on a random sample.
SAMPLE_ROW_THRESHOLD=1000000
SAMPLE_SIZE=100000

# --- Sandboxed kernel execution ---
# Built with `docker build -t datapilot-kernel:latest backend/kernel_image/` and
# `docker build -t datapilot-kernel-relay:latest backend/relay_image/`.
KERNEL_IMAGE=datapilot-kernel:latest
KERNEL_RELAY_IMAGE=datapilot-kernel-relay:latest
KERNEL_NETWORK_INTERNAL=datapilot-kernel-internal
KERNEL_NETWORK_PUBLIC=datapilot-kernel-public
KERNEL_MEMORY_LIMIT=1g
KERNEL_CPU_LIMIT=1.0
KERNEL_IDLE_TIMEOUT_MINUTES=30
KERNEL_CELL_TIMEOUT_SECONDS=120
KERNEL_STARTUP_TIMEOUT_SECONDS=60

# --- Sandboxed kernel resource limits (Phase 8) ---
# Cumulative wall-clock kernel execution time allowed per session across its whole lifetime
# (including after crash-recovery restarts), on top of KERNEL_CELL_TIMEOUT_SECONDS above, which
# only bounds a single cell. 0 disables it.
KERNEL_SESSION_COMPUTE_BUDGET_SECONDS=1800

# --- Auth (Phase 8): email magic-link login ---
# Set a real random value before deploying anywhere reachable by someone else — this is what
# makes the session cookie unforgeable: `python -c "import secrets; print(secrets.token_hex(32))"`
AUTH_SECRET_KEY=dev-insecure-secret-change-me
AUTH_MAGIC_LINK_TTL_MINUTES=15
AUTH_SESSION_TTL_DAYS=30
AUTH_COOKIE_NAME=datapilot_session
# Used to build the magic-link URL mailed to the user (or returned directly in dev mode below).
FRONTEND_BASE_URL=http://localhost:3000
# Leave SMTP_HOST empty for local dev: POST /auth/request-link then returns the magic link
# directly in its response (and logs it) instead of emailing it. Fill these in to send real mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@datapilot.local
SMTP_USE_TLS=true

# --- API rate limiting (Phase 8) ---
# Requests per client IP per minute, independent of the LLM rate limiting above. 0 disables it.
API_RATE_LIMIT_PER_MINUTE=120

# --- App ---
ENV=development
LOG_LEVEL=INFO

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
