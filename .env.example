# --- LLM ---
# Free-tier Gemini Flash model, accessed via LiteLLM. Never hardcode model names elsewhere.
LLM_MODEL=gemini/<current-gemini-flash-model>
# Comma-separated fallback models, e.g. a Groq model.
LLM_FALLBACKS=groq/<groq-model>
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_API_BASE=http://localhost:11434

# NOTE: the following four values are placeholders. Set them from your
# provider's current free-tier limits (Gemini/Groq dashboards) before
# relying on the rate limiter or call budget in production.
LLM_MAX_CALLS_PER_SESSION=150
LLM_RPM_LIMIT=10
LLM_TPM_LIMIT=200000
LLM_CACHE_TTL_SECONDS=86400

LLM_SAMPLE_ROWS=20

# --- Infra ---
DATABASE_URL=postgresql+asyncpg://datapilot:datapilot@localhost:5432/datapilot
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=datapilot-uploads

# --- Uploads & profiling ---
MAX_UPLOAD_SIZE_MB=200
# Rows cached for the virtualized preview table in the UI.
PREVIEW_ROW_LIMIT=500
# Above this row count, profiling statistics are computed on a random sample.
SAMPLE_ROW_THRESHOLD=1000000
SAMPLE_SIZE=100000

# --- App ---
ENV=development
LOG_LEVEL=INFO

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
